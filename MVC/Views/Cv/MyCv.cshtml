@model Models.CV
@{
    ViewData["Title"] = "Mitt CV";
}

<div class="cv-container">
    <!-- CV-header med profilinfo OCH BILDUPLADDNING -->
    <div class="cv-header">
        <div class="profile-image-container position-relative">
            <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/standard.png" : Model.ProfileImage)"
                 alt="Profilbild"
                 class="cv-profile-img rounded-circle"
                 id="profileImage"
                 data-bs-toggle="modal"
                 data-bs-target="#uploadImageModal">

            <!-- Edit overlay på bilden -->
            <div class="profile-image-overlay rounded-circle">
                <i class="bi bi-camera"></i>
                <small>Klicka för att ändra</small>
            </div>
        </div>

        <div class="cv-header-info ms-3">
            <h1 class="mb-1">@Model.User.Name</h1>
            <p class="text-muted mb-0">@Model.User.Address</p>
        </div>

        <button class="btn btn-outline-primary ms-auto" data-bs-toggle="modal" data-bs-target="#editCvModal">
            <i class="bi bi-pencil"></i> Redigera CV
        </button>
    </div>

    <!-- Arbetserfarenheter -->
    <section class="cv-section mt-4">
        <h2 class="border-bottom pb-2">
            <i class="bi bi-briefcase"></i> Arbetserfarenhet
        </h2>
        @if (Model.WorkExperiences?.Any() == true)
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var exp in Model.WorkExperiences)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-1">@exp.Title</h5>
                                    <span class="badge bg-light text-dark">
                                        @exp.StartDate?.ToString("MMM yyyy") -
                                        @(exp.EndDate?.ToString("MMM yyyy") ?? "Nuvarande")
                                    </span>
                                </div>
                                <h6 class="card-subtitle mb-2 text-muted">@exp.WorkPlace?.Name</h6>
                                <p class="card-text">@exp.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic">Ingen arbetserfarenhet tillagd</p>
        }
    </section>

    <!-- Utbildning -->
    <section class="cv-section mt-4">
        <h2 class="border-bottom pb-2">
            <i class="bi bi-mortarboard"></i> Utbildning
        </h2>
        @if (Model.Educations?.Any() == true)
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var edu in Model.Educations)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@edu.ProgramOrCourseName</h5>
                                <h6 class="card-subtitle mb-2 text-muted">@edu.Institution?.Name</h6>
                                <div class="mt-3">
                                    <span class="badge bg-primary">
                                        @edu.StartDate?.ToString("yyyy") - @(edu.EndDate?.ToString("yyyy") ?? "Nuvarande")
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(edu.Description))
                                {
                                    <p class="card-text mt-2">@edu.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic">Ingen utbildning tillagd</p>
        }
    </section>

    <!-- Kompetenser -->
    <section class="cv-section mt-4">
        <h2 class="border-bottom pb-2">
            <i class="bi bi-star"></i> Kompetenser
        </h2>
        @if (Model.Competences?.Any() == true)
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var comp in Model.Competences)
                {
                    <span class="badge bg-light text-dark border p-2">@comp.Name</span>
                }
            </div>
        }
        else
        {
            <p class="text-muted fst-italic">Inga kompetenser tillagda</p>
        }
    </section>
</div>

<!-- Bootstrap Modal för bilduppladdning -->
<div class="modal fade" id="uploadImageModal" tabindex="-1" aria-labelledby="uploadImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadImageModalLabel">Ändra profilbild</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <form id="uploadImageForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="profileImageFile" class="form-label">Välj bild</label>
                        <input type="file" class="form-control" id="profileImageFile"
                               name="profileImage" accept=".jpg,.jpeg,.png" required>
                        <div class="form-text">
                            Endast .jpg, .jpeg eller .png filer. Max 5MB.
                        </div>
                    </div>

                    <div class="image-preview mb-3 text-center">
                        <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/standard.png" : Model.ProfileImage)"
                             class="img-thumbnail rounded-circle" style="width: 150px; height: 150px; object-fit: cover;">
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Bilden kommer att beskäras till kvadratisk form automatiskt.
                    </div>
                </form>

                <!-- Progress bar -->
                <div class="progress mt-3" style="height: 20px; display: none;" id="uploadProgressContainer">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         id="uploadProgressBar" style="width: 0%">
                        0%
                    </div>
                </div>

                <!-- Felmeddelanden -->
                <div class="alert alert-danger mt-3" style="display: none;" id="uploadError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="uploadImageBtn">
                    <i class="bi bi-upload"></i> Ladda upp
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Modal för CV-redigering (utan profilbild) -->
<div class="modal fade" id="editCvModal" tabindex="-1" aria-labelledby="editCvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCvModalLabel">Redigera CV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <form id="editCvForm" method="post" asp-action="Edit">

                    <!-- Arbetserfarenheter -->
                    <div class="mb-4">
                        <h6 class="mb-3">Arbetserfarenheter</h6>
                        <div id="workExperiencesContainer">
                            @if (Model.WorkExperiences?.Any() == true)
                            {
                                for (int i = 0; i < Model.WorkExperiences.Count; i++)
                                {
                                    var exp = Model.WorkExperiences[i];
                                    <div class="work-experience-entry border p-3 mb-3 rounded">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <input type="text" class="form-control"
                                                       name="WorkExperiences[@i].Title"
                                                       value="@exp.Title" placeholder="Titel" required>
                                            </div>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control"
                                                       name="WorkExperiences[@i].WorkPlace.Name"
                                                       value="@exp.WorkPlace?.Name" placeholder="Företag">
                                            </div>
                                            <div class="col-md-6">
                                                <input type="date" class="form-control"
                                                       name="WorkExperiences[@i].StartDate"
                                                       value="@exp.StartDate?.ToString("yyyy-MM-dd")">
                                            </div>
                                            <div class="col-md-6">
                                                <input type="date" class="form-control"
                                                       name="WorkExperiences[@i].EndDate"
                                                       value="@exp.EndDate?.ToString("yyyy-MM-dd")">
                                            </div>
                                            <div class="col-12">
                                                <textarea class="form-control" rows="2"
                                                  name="WorkExperiences[@i].Description"
                                                  placeholder="Beskrivning">@exp.Description</textarea>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="cv.addWorkExperience()">
                            <i class="bi bi-plus"></i> Lägg till erfarenhet
                        </button>
                    </div>

                    <!-- Utbildningar -->
                    <div class="mb-4">
                        <h6 class="mb-3">Utbildningar</h6>
                        <div id="educationsContainer">
                            @if (Model.Educations?.Any() == true)
                            {
                                for (int i = 0; i < Model.Educations.Count; i++)
                                {
                                    var edu = Model.Educations[i];
                                    <div class="education-entry border p-3 mb-3 rounded">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <input type="text" class="form-control"
                                                       name="Educations[@i].ProgramOrCourseName"
                                                       value="@edu.ProgramOrCourseName" placeholder="Program/Kursnamn" required>
                                            </div>
                                            <div class="col-md-6">
                                                <input type="text" class="form-control"
                                                       name="Educations[@i].Institution.Name"
                                                       value="@edu.Institution?.Name" placeholder="Skola/Universitet">
                                            </div>
                                            <div class="col-md-6">
                                                <input type="date" class="form-control"
                                                       name="Educations[@i].StartDate"
                                                       value="@edu.StartDate?.ToString("yyyy-MM-dd")">
                                            </div>
                                            <div class="col-md-6">
                                                <input type="date" class="form-control"
                                                       name="Educations[@i].EndDate"
                                                       value="@edu.EndDate?.ToString("yyyy-MM-dd")">
                                            </div>
                                            <div class="col-12">
                                                <textarea class="form-control" rows="2"
                                                  name="Educations[@i].Description"
                                                  placeholder="Beskrivning">@edu.Description</textarea>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="cv.addEducation()">
                            <i class="bi bi-plus"></i> Lägg till utbildning
                        </button>
                    </div>

                    <!-- Kompetenser -->
                    <div class="mb-4">
                        <h6 class="mb-3">Kompetenser</h6>
                        <div id="competencesContainer">
                            @if (Model.Competences?.Any() == true)
                            {
                                for (int i = 0; i < Model.Competences.Count; i++)
                                {
                                    var comp = Model.Competences[i];
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control"
                                               name="Competences[@i].Name"
                                               value="@comp.Name" placeholder="Kompetens" required>
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="cv.removeCompetence(this)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="cv.addCompetence()">
                            <i class="bi bi-plus"></i> Lägg till kompetens
                        </button>
                    </div>

                    <!-- Dolda fält -->
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="UserId" value="@Model.UserId" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="submit" form="editCvForm" class="btn btn-primary">Spara ändringar</button>
            </div>
        </div>
    </div>
</div>

<div id="cvData"
     data-work-exp-count="@(Model.WorkExperiences?.Count ?? 0)"
     data-education-count="@(Model.Educations?.Count ?? 0)"
     data-competence-count="@(Model.Competences?.Count ?? 0)"
     data-upload-url="@Url.Action("UploadProfileImage", "Cv")"
     style="display: none;">
</div>

@section Scripts {
    <script src="~/js/cv.js" asp-append-version="true"></script>
}