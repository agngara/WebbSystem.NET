@model Models.CVViewModel
@{
    ViewData["Title"] = "Redigera mitt CV";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="UpdateCV" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-4">
                <!-- Profilbild -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Profilbild</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(Model.ExistingProfileImage))
                        {
                            <img src="@Model.ExistingProfileImage" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Nuvarande bild">
                        }
                        <div class="mb-3">
                            <label for="ProfileImageFile" class="form-label">Ladda upp ny bild</label>
                            <input type="file" class="form-control" asp-for="ProfileImageFile" accept="image/*">
                            <span asp-validation-for="ProfileImageFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Projekt -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Projekt</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.AvailableProjects.Any())
                        {
                            <div class="form-group">
                                @for (int i = 0; i < Model.AvailableProjects.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" asp-for="@Model.AvailableProjects[i].Id" />
                                        <input type="hidden" asp-for="@Model.AvailableProjects[i].Title" />
                                        <input class="form-check-input" type="checkbox"
                                               asp-for="@Model.AvailableProjects[i].IsSelected" />
                                        <label class="form-check-label" asp-for="@Model.AvailableProjects[i].IsSelected">
                                            @Model.AvailableProjects[i].Title
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Inga projekt tillgängliga</p>
                        }
                    </div>
                </div>

                <!-- Profilvisningar -->
                @if (ViewBag.ProfileViews != null)
                {
                    <div class="card">
                        <div class="card-header">
                            <h5>Statistik</h5>
                        </div>
                        <div class="card-body">
                            <p>Din profil har visats <strong>@ViewBag.ProfileViews</strong> gånger</p>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-8">
                <!-- Beskrivning -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Om mig</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Kompetenser -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Kompetenser</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addCompetenceBtn">
                            + Lägg till kompetens
                        </button>
                    </div>
                    <div class="card-body" id="competencesContainer">
                        @for (int i = 0; i < Model.Competences.Count; i++)
                        {
                            <div class="row mb-2 competence-row">
                                <div class="col">
                                    <input type="hidden" asp-for="@Model.Competences[i].Id" />
                                    <input asp-for="@Model.Competences[i].Name" class="form-control" placeholder="Kompetensnamn" />
                                    <span asp-validation-for="@Model.Competences[i].Name" class="text-danger"></span>
                                </div>
                                <div class="col-auto">
                                    <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Arbetserfarenhet -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Arbetserfarenhet</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addWorkExperienceBtn">
                            + Lägg till erfarenhet
                        </button>
                    </div>
                    <div class="card-body" id="workExperiencesContainer">
                        @for (int i = 0; i < Model.WorkExperiences.Count; i++)
                        {
                            <div class="work-experience-row mb-4 p-3 border rounded">
                                <input type="hidden" asp-for="@Model.WorkExperiences[i].Id" />

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].Title" class="form-label">Titel</label>
                                        <input asp-for="@Model.WorkExperiences[i].Title" class="form-control" />
                                        <span asp-validation-for="@Model.WorkExperiences[i].Title" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].CompanyName" class="form-label">Företag</label>
                                        <input asp-for="@Model.WorkExperiences[i].CompanyName" class="form-control" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].StartDate" class="form-label">Startdatum</label>
                                        <input type="date" asp-for="@Model.WorkExperiences[i].StartDate" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].EndDate" class="form-label">Slutdatum</label>
                                        <input type="date" asp-for="@Model.WorkExperiences[i].EndDate" class="form-control" />
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label asp-for="@Model.WorkExperiences[i].Description" class="form-label">Beskrivning</label>
                                    <textarea asp-for="@Model.WorkExperiences[i].Description" class="form-control" rows="2"></textarea>
                                </div>

                                <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Utbildning -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Utbildning</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addEducationBtn">
                            + Lägg till utbildning
                        </button>
                    </div>
                    <div class="card-body" id="educationsContainer">
                        @for (int i = 0; i < Model.Educations.Count; i++)
                        {
                            <div class="education-row mb-4 p-3 border rounded">
                                <input type="hidden" asp-for="@Model.Educations[i].Id" />

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].ProgramOrCourseName" class="form-label">Program/Kurs</label>
                                        <input asp-for="@Model.Educations[i].ProgramOrCourseName" class="form-control" />
                                        <span asp-validation-for="@Model.Educations[i].ProgramOrCourseName" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].InstitutionName" class="form-label">Institution/Skola</label>
                                        <input asp-for="@Model.Educations[i].InstitutionName" class="form-control" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].StartDate" class="form-label">Startdatum</label>
                                        <input type="date" asp-for="@Model.Educations[i].StartDate" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].EndDate" class="form-label">Slutdatum</label>
                                        <input type="date" asp-for="@Model.Educations[i].EndDate" class="form-control" />
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label asp-for="@Model.Educations[i].Description" class="form-label">Beskrivning</label>
                                    <textarea asp-for="@Model.Educations[i].Description" class="form-control" rows="2"></textarea>
                                </div>

                                <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">Spara CV</button>
                    <a asp-action="View" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
                       class="btn btn-outline-secondary">Avbryt</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Lägg till kompetensrad
        document.getElementById('addCompetenceBtn')?.addEventListener('click', function() {
            const container = document.getElementById('competencesContainer');
            const index = container.querySelectorAll('.competence-row').length;

            const html = `
                <div class="row mb-2 competence-row">
                    <div class="col">
                        <input type="hidden" name="Competences[${index}].Id" value="" />
                        <input name="Competences[${index}].Name" class="form-control" placeholder="Kompetensnamn" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Lägg till arbetserfarenhet
        document.getElementById('addWorkExperienceBtn')?.addEventListener('click', function() {
            const container = document.getElementById('workExperiencesContainer');
            const index = container.querySelectorAll('.work-experience-row').length;

            const html = `
                <div class="work-experience-row mb-4 p-3 border rounded">
                    <input type="hidden" name="WorkExperiences[${index}].Id" value="" />

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Titel</label>
                            <input name="WorkExperiences[${index}].Title" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Företag</label>
                            <input name="WorkExperiences[${index}].CompanyName" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Startdatum</label>
                            <input type="date" name="WorkExperiences[${index}].StartDate" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Slutdatum</label>
                            <input type="date" name="WorkExperiences[${index}].EndDate" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Beskrivning</label>
                        <textarea name="WorkExperiences[${index}].Description" class="form-control" rows="2"></textarea>
                    </div>

                    <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Lägg till utbildning
        document.getElementById('addEducationBtn')?.addEventListener('click', function() {
            const container = document.getElementById('educationsContainer');
            const index = container.querySelectorAll('.education-row').length;

            const html = `
                <div class="education-row mb-4 p-3 border rounded">
                    <input type="hidden" name="Educations[${index}].Id" value="" />

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Program/Kurs</label>
                            <input name="Educations[${index}].ProgramOrCourseName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Institution/Skola</label>
                            <input name="Educations[${index}].InstitutionName" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Startdatum</label>
                            <input type="date" name="Educations[${index}].StartDate" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Slutdatum</label>
                            <input type="date" name="Educations[${index}].EndDate" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Beskrivning</label>
                        <textarea name="Educations[${index}].Description" class="form-control" rows="2"></textarea>
                    </div>

                    <button type="button" class="btn btn-danger btn-sm remove-row">Ta bort</button>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Ta bort rader
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-row')) {
                e.target.closest('.competence-row, .work-experience-row, .education-row')?.remove();

                // Uppdatera index för alla element
                updateIndices();
            }
        });

        function updateIndices() {
            // Uppdatera kompetenser
            document.querySelectorAll('.competence-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input');
                inputs[0].name = `Competences[${index}].Id`;
                inputs[1].name = `Competences[${index}].Name`;
            });

            // Uppdatera arbetserfarenheter
            document.querySelectorAll('.work-experience-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input, textarea');
                inputs[0].name = `WorkExperiences[${index}].Id`;
                inputs[1].name = `WorkExperiences[${index}].Title`;
                inputs[2].name = `WorkExperiences[${index}].CompanyName`;
                inputs[3].name = `WorkExperiences[${index}].StartDate`;
                inputs[4].name = `WorkExperiences[${index}].EndDate`;
                inputs[5].name = `WorkExperiences[${index}].Description`;
            });

            // Uppdatera utbildningar
            document.querySelectorAll('.education-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input, textarea');
                inputs[0].name = `Educations[${index}].Id`;
                inputs[1].name = `Educations[${index}].ProgramOrCourseName`;
                inputs[2].name = `Educations[${index}].InstitutionName`;
                inputs[3].name = `Educations[${index}].StartDate`;
                inputs[4].name = `Educations[${index}].EndDate`;
                inputs[5].name = `Educations[${index}].Description`;
            });
        }
    </script>
}