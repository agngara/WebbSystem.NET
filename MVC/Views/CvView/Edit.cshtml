@model Models.CvEditModel

<link rel="stylesheet" href="~/css/cv.css" asp-append-version="true" />
<script src="~/js/cv.js" asp-append-version="true"></script>

@{
    ViewData["Title"] = "Edit My CV";
    var userId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="UpdateCV" method="post" id="cvForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProfileImageBase64" id="imageBase64" />

        <div class="row">
            <div class="col-md-4">
                <!-- Profile Picture -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Profile Picture</h5>
                    </div>
                    <div class="card-body text-center">
                        <!-- Show existing image -->
                        @if (!string.IsNullOrEmpty(Model.ExistingProfileImage) && Model.ExistingProfileImage !=
                                                "pfp/standard.png")
                        {
                            <img src="@Model.ExistingProfileImage" class="rounded-circle mb-3"
                                 style="width: 150px; height: 150px; object-fit: cover;" alt="Current image"
                                 id="existingImage" onerror="this.src='/pfp/standard.png'">
                        }
                        else
                        {
                            <img src="/pfp/standard.png" class="rounded-circle mb-3"
                                 style="width: 150px; height: 150px; object-fit: cover;" alt="Default profile picture"
                                 id="existingImage">
                        }

                        <!-- Preview of new image -->
                        <img id="imagePreview" class="rounded-circle mb-3"
                             style="width: 150px; height: 150px; object-fit: cover; display: none;" alt="New image">

                        <!-- Image option 1: File upload -->
                        <div class="mb-3">
                            <label class="form-label">Upload new picture</label>
                            <input type="file" id="imageUpload" class="form-control" accept="image/*" />
                            <small class="text-muted">Max 2MB, JPG/PNG/GIF</small>
                        </div>
                    </div>
                </div>

                <!-- Projekt -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Projekt</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.AvailableProjects.Any())
                        {
                            <div class="form-group">
                                @for (int i = 0; i < Model.AvailableProjects.Count; i++)
                                {
                                    <div class="form-check mb-2">
                                        <input type="hidden" asp-for="@Model.AvailableProjects[i].Id" />
                                        <input type="hidden" asp-for="@Model.AvailableProjects[i].Title" />
                                        <input class="form-check-input" type="checkbox"
                                            asp-for="@Model.AvailableProjects[i].IsSelected" />
                                        <label class="form-check-label" asp-for="@Model.AvailableProjects[i].IsSelected">
                                            @Model.AvailableProjects[i].Title
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Inga projekt tillgängliga</p>
                        }
                    </div>
                </div>

                <!-- Profile views -->
                @if (ViewBag.ProfileViews != null)
                {
                    <div class="card">
                        <div class="card-header">
                            <h5>Statistics</h5>
                        </div>
                        <div class="card-body">
                            <p>Your profile has been viewed <strong>@ViewBag.ProfileViews</strong> times</p>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-8">
                <!-- Description -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>About Me</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Describe yourself, your interests and career goals..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Skills -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Skills</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addCompetenceBtn">
                            + Add skill
                        </button>
                    </div>
                    <div class="card-body" id="competencesContainer">
                        @for (int i = 0; i < Model.Competences.Count; i++)
                        {
                            <div class="row mb-2 competence-row">
                                <div class="col-10">
                                    <input type="hidden" asp-for="@Model.Competences[i].Id" />
                                    <input asp-for="@Model.Competences[i].Name" class="form-control"
                                           placeholder="E.g. ASP.NET, React, SQL" />
                                    <span asp-validation-for="@Model.Competences[i].Name" class="text-danger"></span>
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn btn-danger btn-sm remove-row">Remove</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Work Experience -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Work Experience</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addWorkExperienceBtn">
                            + Add experience
                        </button>
                    </div>
                    <div class="card-body" id="workExperiencesContainer">
                        @for (int i = 0; i < Model.WorkExperiences.Count; i++)
                        {
                            <div class="work-experience-row mb-4 p-3 border rounded">
                                <input type="hidden" asp-for="@Model.WorkExperiences[i].Id" />

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].Title" class="form-label">Title*</label>
                                        <input asp-for="@Model.WorkExperiences[i].Title" class="form-control"
                                               placeholder="E.g. Developer, Project Manager" />
                                        <span asp-validation-for="@Model.WorkExperiences[i].Title"
                                              class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].CompanyName"
                                               class="form-label">Company</label>
                                        <input asp-for="@Model.WorkExperiences[i].CompanyName" class="form-control"
                                               placeholder="E.g. Microsoft, ICA" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].StartDate"
                                               class="form-label">Start Date</label>
                                        <input type="date" asp-for="@Model.WorkExperiences[i].StartDate"
                                               class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.WorkExperiences[i].EndDate"
                                               class="form-label">End Date</label>
                                        <input type="date" asp-for="@Model.WorkExperiences[i].EndDate"
                                               class="form-control" />
                                        <small class="text-muted">Leave empty if current</small>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label asp-for="@Model.WorkExperiences[i].Description"
                                           class="form-label">Description</label>
                                    <textarea asp-for="@Model.WorkExperiences[i].Description" class="form-control" rows="2"
                                              placeholder="Describe your tasks and responsibilities..."></textarea>
                                </div>

                                <button type="button" class="btn btn-danger btn-sm remove-row">Remove experience</button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Education -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Education</h5>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addEducationBtn">
                            + Add education
                        </button>
                    </div>
                    <div class="card-body" id="educationsContainer">
                        @for (int i = 0; i < Model.Educations.Count; i++)
                        {
                            <div class="education-row mb-4 p-3 border rounded">
                                <input type="hidden" asp-for="@Model.Educations[i].Id" />

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].ProgramOrCourseName"
                                               class="form-label">Program/Course*</label>
                                        <input asp-for="@Model.Educations[i].ProgramOrCourseName" class="form-control"
                                               placeholder="E.g. Computer Science, .NET Development" />
                                        <span asp-validation-for="@Model.Educations[i].ProgramOrCourseName"
                                              class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].InstitutionName"
                                               class="form-label">Institution/School</label>
                                        <input asp-for="@Model.Educations[i].InstitutionName" class="form-control"
                                               placeholder="E.g. Örebro University" />
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].StartDate"
                                               class="form-label">Start Date</label>
                                        <input type="date" asp-for="@Model.Educations[i].StartDate" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="@Model.Educations[i].EndDate" class="form-label">End Date</label>
                                        <input type="date" asp-for="@Model.Educations[i].EndDate" class="form-control" />
                                        <small class="text-muted">Leave empty if current</small>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <label asp-for="@Model.Educations[i].Description" class="form-label">Description</label>
                                    <textarea asp-for="@Model.Educations[i].Description" class="form-control" rows="2"
                                              placeholder="Describe what you learned..."></textarea>
                                </div>

                                <button type="button" class="btn btn-danger btn-sm remove-row">Remove education</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="text-end">
                    <a asp-action="View" asp-route-id="@userId" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary" id="save-cv-btn">Save CV</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // IMAGE UPLOAD
        document.getElementById('imageUpload')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            // Check file size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                alert('File is too large! Max 2MB.');
                this.value = '';
                return;
            }

            // Check file type
            const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                alert('Only JPG, PNG and GIF images are allowed!');
                this.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                // Save as base64 in hidden field
                document.getElementById('imageBase64').value = e.target.result;

                // Show preview
                const preview = document.getElementById('imagePreview');
                const existing = document.getElementById('existingImage');
                const placeholder = document.getElementById('noImagePlaceholder');

                preview.src = e.target.result;
                preview.style.display = 'block';

                if (existing) existing.style.display = 'none';
                if (placeholder) placeholder.style.display = 'none';
            };
            reader.readAsDataURL(file);
        });

        // ========== DYNAMIC FORM ROWS ==========
        // Add skill row
        document.getElementById('addCompetenceBtn')?.addEventListener('click', function () {
            const container = document.getElementById('competencesContainer');
            const index = container.querySelectorAll('.competence-row').length;

            const html = `
                <div class="row mb-2 competence-row">
                    <div class="col-10">
                        <input type="hidden" name="Competences[${index}].Id" value="" />
                        <input name="Competences[${index}].Name" class="form-control"
                               placeholder="E.g. ASP.NET, React, SQL" />
                    </div>
                    <div class="col-2">
                        <button type="button" class="btn btn-danger btn-sm remove-row">Remove</button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Add work experience
        document.getElementById('addWorkExperienceBtn')?.addEventListener('click', function () {
            const container = document.getElementById('workExperiencesContainer');
            const index = container.querySelectorAll('.work-experience-row').length;

            const html = `
                <div class="work-experience-row mb-4 p-3 border rounded">
                    <input type="hidden" name="WorkExperiences[${index}].Id" value="" />

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Title*</label>
                            <input name="WorkExperiences[${index}].Title" class="form-control"
                                   placeholder="E.g. Developer, Project Manager" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Company</label>
                            <input name="WorkExperiences[${index}].CompanyName" class="form-control"
                                   placeholder="E.g. Microsoft, ICA" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="WorkExperiences[${index}].StartDate" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            <input type="date" name="WorkExperiences[${index}].EndDate" class="form-control" />
                            <small class="text-muted">Leave empty if current</small>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Description</label>
                        <textarea name="WorkExperiences[${index}].Description" class="form-control" rows="2"
                                  placeholder="Describe your tasks and responsibilities..."></textarea>
                    </div>

                    <button type="button" class="btn btn-danger btn-sm remove-row">Remove experience</button>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Add education
        document.getElementById('addEducationBtn')?.addEventListener('click', function () {
            const container = document.getElementById('educationsContainer');
            const index = container.querySelectorAll('.education-row').length;

            const html = `
                <div class="education-row mb-4 p-3 border rounded">
                    <input type="hidden" name="Educations[${index}].Id" value="" />

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Program/Course*</label>
                            <input name="Educations[${index}].ProgramOrCourseName" class="form-control"
                                   placeholder="E.g. Computer Science, .NET Development" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Institution/School</label>
                            <input name="Educations[${index}].InstitutionName" class="form-control"
                                   placeholder="E.g. Örebro University" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="Educations[${index}].StartDate" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            <input type="date" name="Educations[${index}].EndDate" class="form-control" />
                            <small class="text-muted">Leave empty if current</small>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Description</label>
                        <textarea name="Educations[${index}].Description" class="form-control" rows="2"
                                  placeholder="Describe what you learned..."></textarea>
                    </div>

                    <button type="button" class="btn btn-danger btn-sm remove-row">Remove education</button>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
        });

        // Remove rows
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-row')) {
                e.target.closest('.competence-row, .work-experience-row, .education-row')?.remove();
                updateIndices();
            }
        });

        function updateIndices() {
            // Update skills
            document.querySelectorAll('.competence-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input');
                if (inputs[0]) inputs[0].name = `Competences[${index}].Id`;
                if (inputs[1]) inputs[1].name = `Competences[${index}].Name`;
            });

            // Update work experiences
            document.querySelectorAll('.work-experience-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input, textarea');
                if (inputs[0]) inputs[0].name = `WorkExperiences[${index}].Id`;
                if (inputs[1]) inputs[1].name = `WorkExperiences[${index}].Title`;
                if (inputs[2]) inputs[2].name = `WorkExperiences[${index}].CompanyName`;
                if (inputs[3]) inputs[3].name = `WorkExperiences[${index}].StartDate`;
                if (inputs[4]) inputs[4].name = `WorkExperiences[${index}].EndDate`;
                if (inputs[5]) inputs[5].name = `WorkExperiences[${index}].Description`;
            });

            // Update education
            document.querySelectorAll('.education-row').forEach((row, index) => {
                const inputs = row.querySelectorAll('input, textarea');
                if (inputs[0]) inputs[0].name = `Educations[${index}].Id`;
                if (inputs[1]) inputs[1].name = `Educations[${index}].ProgramOrCourseName`;
                if (inputs[2]) inputs[2].name = `Educations[${index}].InstitutionName`;
                if (inputs[3]) inputs[3].name = `Educations[${index}].StartDate`;
                if (inputs[4]) inputs[4].name = `Educations[${index}].EndDate`;
                if (inputs[5]) inputs[5].name = `Educations[${index}].Description`;
            });
        }

        // Validation on submit
        document.getElementById('cvForm')?.addEventListener('submit', function (e) {
            // Check that at least one field is filled in each section
            const competences = document.querySelectorAll('input[name^="Competences["]');
            const hasCompetences = Array.from(competences).some(input => input.value.trim() !== '');

        });
    </script>
}