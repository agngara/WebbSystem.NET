@model LoginViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="login-wrapper">
    <div class="login-left-box">
        <h1><span>PinkedOut</span></h1>
        <p>We make your CV <span>out</span>shine the compitition</p>
    </div>

    <form id="registerForm" class="login-form" method="post" asp-action="LogIn">
        <div class="login">
            <h2 class="login-header">USER LOGIN</h2>

            <div class="input-outer">
                <label for="username">Username</label>
                <div class="input-wrapper">
                    <input id="username" asp-for="UserName" type="text" placeholder="">
                    <img src="~/icons/User.svg" alt="User Logo">
                </div>
                <p id="error-UserName" class="error-text"></p>
            </div>

            <div class="input-outer">
                <label for="password">Password</label>
                <div class="input-wrapper">
                    <input id="password" asp-for="Password" type="password" placeholder="">
                    <img src="~/icons/Password.svg" alt="Password Logo">
                </div>
                <p id="error-Password" class="error-text"></p>
            </div>

            <div class="remember-register-wrapper">
                <div class="rememberme-wrapper">
                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Remember Me
                    </label>
                </div>

                <a asp-action="Register">Register Account</a>
            </div>


            <input value="LOGIN" type="submit" id="login-btn">
        </div>

    </form>
</div>

<script src="~/js/account.js"></script>
