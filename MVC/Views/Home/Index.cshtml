@model HomepageViewModel;
@using System.Security.Claims;
@{
    ViewData["title"] = "LinkedOut";
}
<link rel="stylesheet" href="~/css/homepage.css"/>
<script src="~/js/homepage.js" defer></script>

<section class="homepage-landing">

    <div id="homepage-container">
        <div class="brandcell">
            <h2>All </h2>
            <h2 id="pinked">Pinked</h2>
            <h2 id="out">Out</h2>
        </div>
        <div class="textcell">
            <p>Register and start getting connected - browse CV:s and upload your own.</p>
        </div>
        <div class="buttoncell">
            <a asp-controller="Account" asp-action="Register" class="custom-button-large-accent">Register</a>
        </div>
    </div>

    <ul class="parallax-layers">
        <li class="layer"></li>
        <li class="layer"></li>
        <li class="layer"></li>
        <li class="layer"></li>
    </ul>



</section>

<h2 class="slide-title">Popular Profiles</h2>

<section class="slider-window">
    <div class="arrow-left" id="slide-1-arrow-left">
        <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
    </div>
    <div class="arrow-right" id="slide-1-arrow-right">
        <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
    </div>
    <section class="scroll-container">
        @foreach (Models.CV cv in Model.TopCVs)
        {
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                @if (!string.IsNullOrEmpty(cv.ProfileImage))
                {
                    <img src="@cv.ProfileImage" class="card-img-top" alt="@cv.User?.Name"
                         style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <img src="~/pfp/standard.png" class="card-img-top"
                         alt="Default profile" style="height: 200px; object-fit: cover;">
                }

                <div class="card-body">
                    <h5 class="card-title">@cv.User?.Name</h5>
                    <p class="card-text">@(cv.Description?.Length > 100 ? cv.Description.Substring(0, 100) + "..." : cv.Description)</p>
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        @if (cv.Educations?.Any() == true)
                        {
                            @cv.Educations.Last().ProgramOrCourseName
                        }
                        else
                        {
                            <span class="text-muted">Ingen utbildning</span>
                        }
                    </li>

                    <li class="list-group-item">
                        @if (cv.WorkExperiences?.Any() == true)
                        {
                            @cv.WorkExperiences.Last().Title
                        }
                        else
                        {
                            <span class="text-muted">Ingen erfarenhet</span>
                        }
                    </li>
                </ul>

                <div class="card-body">
                    <a asp-controller="CV" asp-action="View" asp-route-id="@cv.User?.Id"
                       class="custom-button">See profile</a>
                </div>
            </div>
        }
    </section>
</section>
<div class="title-grid">
    <h2 class="title-grid-item1">Latest Projects</h2>
    <p class="title-grid-item2"><a asp-action="Catalog" asp-controller="Project">Browse all -></a></p>
 </div>

<section class="slider-window">
    <div class="arrow-left" id="slide-1-arrow-left-2">
        <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
    </div>
    <div class="arrow-right" id="slide-1-arrow-right-2">
        <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
    </div>
    <section class="scroll-container">
        @foreach (Models.Project project in Model.LatestProjects)
        {
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UI-Images/project_placeholder_image.jpg" class="card-img-top" alt="Placeholder-imag">
                <div class="card-body">
                    <h5 class="card-title">@project.Titel</h5>
                    <p class="card-text">Created by @project.Creator.Name</p>
                    <p class="card-text">@project.Description</p>
                </div>

                <div class="card-body">
                    @*Displays buttons for anonymous users*@
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a class="custom-button" asp-action="Login" asp-controller="Account">Join</a>
                        <a class="custom-button" asp-action="Login" asp-controller="Account">See participants</a>
                    }
                    else
                    {
                        @*Otherwise, checks if user is or is not creator of project*@
                        if (User.FindFirstValue(ClaimTypes.NameIdentifier) != project.CreatorId)
                        {
                            bool isJoined = false;
                            @*Loops through userlist to see if user is a participant of the project*@
                            foreach (var user in project.ProjectUsers)
                            {
                                if (user.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                {
                                    isJoined = true;
                                    break;
                                }
                            }
                            if (isJoined == false)
                            {
                                <a class="custom-button" asp-controller="Project" asp-action="Join" asp-route-projectId="@project.Id">Join</a>
                            }
                            else
                            {
                                <a class="custom-button" asp-controller="Project" asp-action="Leave" asp-route-projectId="@project.Id">Leave</a>
                            }
                        }
                        else
                        {
                            <button class="custom-button">Edit</button>
                        }
                        <button class="custom-button">See participants</button>
                    }
                </div>
            </div>
        }

    </section>
</section>




