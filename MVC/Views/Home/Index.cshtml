@model HomepageViewModel;
@{
    ViewData["title"] = "LinkedOut";
}
<link rel="stylesheet" href="~/css/homepage.css" />
<script src="~/js/homepage.js" defer></script>

<section class="homepage-landing">

    <div id="homepage-container">
        <div class="brandcell">
            <h2>All </h2>
            <h2 id="pinked">Pinked</h2>
            <h2 id="out">Out</h2>
        </div>
        <div class="textcell">
            <p>Register and start getting connected - browse CV:s and upload your own.</p>
        </div>
        <div class="buttoncell">
            <button class="custom-button">Register</button>
        </div>
    </div>

    <ul class="parallax-layers">
        <li class="layer"></li>
        <li class="layer"></li>
        <li class="layer"></li>
        <li class="layer"></li>
    </ul>



</section>

<h2 class="slide-title">Popular Profiles</h2>

<section class="slider-window">
    <div class="arrow-left" id="slide-1-arrow-left">
        <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
    </div>
    <div class="arrow-right" id="slide-1-arrow-right">
        <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
    </div>
    <section class="scroll-container">
        @foreach (Models.CV cv in Model.TopCVs)
        {
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UserUploads/stanprofilepic.png" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@cv.User.Name</h5>
                    <p class="card-text">@cv.Description</p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">@cv.Educations.Last().ProgramOrCourseName</li>
                    <li class="list-group-item">@cv.WorkExperiences.Last().Title</li>
                </ul>
                <div class="card-body">
                    <button class="custom-button">See profile</button>
                </div>
            </div>
        }

    </section>
</section>

<h2 class="slide-title">Explore latest projects</h2>
<section class="slider-window">
    <div class="arrow-left" id="slide-1-arrow-left-2">
        <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
    </div>
    <div class="arrow-right" id="slide-1-arrow-right-2">
        <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
    </div>
    <section class="scroll-container">
        @foreach (Models.Project project in Model.LatestProjects)
        {
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UI-Images/project_placeholder_image.jpg" class="card-img-top" alt="Placeholder-imag">
                <div class="card-body">
                    <h5 class="card-title">@project.Titel</h5>
                    <p class="card-text">@project.Description</p>
                </div>

                <div class="card-body">
                    <button class="custom-button">Explore project</button>
                </div>
            </div>
        }

    </section>
</section>




