@model CreateProjectViewModel
@using System.Security.Claims
@{
    Model.UserId = User.FindFirstValue(ClaimTypes.NameIdentifier);   
}

<link rel="stylesheet" href="~/css/catalog.css" />

<section class="create-project-popup">
    <div class="top-bar">
        <h2 id="create-title">Create New Project</h2>
        <h2 id="close-create">X</h2>
    </div>
    <div class="create-project-form">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="Name" class="form-label">Project Name</label>
                <input type="text" class="form-control" id="Name" asp-for="Name">
            </div>
            <div class="mb-3">
                <label for="Description" class="form-label">Description</label>
                <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" asp-for="Description"></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Project Image</label>
                <input class="form-control" type="file" id="image" accept="image/*" asp-for="ImageFile">
                <div id="fileHelp" class="form-text">Max 2MB, JPG/PNG/GIF</div>

            </div>
            <button type="submit" class="custom-button-accent">Submit</button>
        </form>
    </div>
</section>
