@model CatalogViewModel;
@using System.Security.Claims;



<!DOCTYPE html>
    <html>
    <head>
        <title>LinkedOut</title>
        <link rel="stylesheet" href="~/css/catalog.css"/>
        <script src="~/js/project.js" defer></script>

</head>
    <body>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
    <h2 class="slide-title">My Projects</h2>
    <section class="slider-window">
        <div class="arrow-left" id="slide-1-arrow-left-2">
            <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
        </div>
        <div class="arrow-right" id="slide-1-arrow-right-2">
            <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
        </div>
        <section class="scroll-container">
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UI-Images/addprojectimage3.png" class="card-img" alt="Placeholder-imag">
                
            </div>
            @foreach (Models.Project project in Model.userProjects)
            {
                <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                    <img src="~/Assets/UI-Images/project_placeholder_image.jpg" class="card-img-top" alt="Placeholder-image">
                    <div class="card-body">
                        <h5 class="card-title">@project.Titel</h5>
                        <p class="card-text">@project.Description</p>
                    </div>

                    <div class="card-body">
                        <button class="custom-button">Explore project</button>
                    </div>
                </div>
            }

        </section>
    </section>
    }
    <h2 class="slide-title">All Projects</h2>
        
    <section class="all-projects-container">
        @foreach (Models.Project project in Model.allProjects)
        {
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UI-Images/project_placeholder_image.jpg" class="card-img-top" alt="Placeholder-imag">
                <div class="card-body">
                    <h5 class="card-title">@project.Titel</h5>
                    <p class="card-text">Created by @project.Creator.Name</p>
                    <p class="card-text">@project.Description</p>
                </div>

                <div class="card-body">
                    @*Displays buttons for anonymous users*@
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a class="custom-button" asp-action="Login" asp-controller="Account">Join</a>
                        <a class="custom-button" asp-action="Login" asp-controller="Account">See participants</a>
                    }
                    else
                    {
                        @*Otherwise, checks if user is or is not creator of project*@
                        if (User.FindFirstValue(ClaimTypes.NameIdentifier) != project.CreatorId)
                        {
                            bool isJoined = false;
                            @*Loops through userlist to see if user is a participant of the project*@
                            foreach (var user in project.ProjectUsers)
                            {
                                if (user.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                {
                                    isJoined = true;
                                    break;
                                }
                            }
                            if (isJoined == false)
                            {
                                <button class="custom-button">Join</button>
                            }
                            else
                            {
                                <button class="custom-button">Leave</button>
                            }
                        }
                        else
                        {
                            <button class="custom-button">Edit</button>
                        }
                        <button class="custom-button">See participants</button>
                    }
                </div>
            </div>
        }
        
    </section>

    <section class="create-project-popup">
        <div class="top-bar">
            <h1 id="create-title">Create New Project</h1>
            <h1 id="close-create">X</h1>
        </div>
        <div class="create-project-form">
            <form>
                <div class="mb-3">
                    <label for="Name" class="form-label">Project Name</label>
                    <input type="text" class="form-control" id="Name">
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea class="form-control" id="exampleFormControlTextarea1" rows="3"></textarea>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="exampleCheck1">
                    <label class="form-check-label" for="exampleCheck1">Check me out</label>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Project Image</label>
                    <input class="form-control" type="file" id="image" accept="image/*">
                    <div id="fileHelp" class="form-text">Max 2MB, JPG/PNG/GIF</div>

                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </section>

    </body>
    </html>
