@model CatalogViewModel;

<!DOCTYPE html>
    <html>
    <head>
        <title>LinkedOut</title>
        <link rel="stylesheet" href="~/css/homepage.css"/>
        <script src="~/js/project.js" defer></script>

</head>
    <body>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
    <h2 class="slide-title">My Projects</h2>
    <section class="slider-window">
        <div class="arrow-left" id="slide-1-arrow-left-2">
            <img src="~/Assets/UI-Images/left_arrow_big.png" alt="Left arrow">
        </div>
        <div class="arrow-right" id="slide-1-arrow-right-2">
            <img src="~/Assets/UI-Images/right_arrow_big.png" alt="Right arrow">
        </div>
        <section class="scroll-container">
            <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                <img src="~/Assets/UI-Images/addprojectimage3.png" class="card-img" alt="Placeholder-imag">
                
            </div>
            @foreach (Models.Project project in Model.userProjects)
            {
                <div class="card mx-3 shadow-sm" style="width: 20rem; min-width: 20rem;">
                    <img src="~/Assets/UI-Images/project_placeholder_image.jpg" class="card-img-top" alt="Placeholder-imag">
                    <div class="card-body">
                        <h5 class="card-title">@project.Titel</h5>
                        <p class="card-text">@project.Description</p>
                    </div>

                    <div class="card-body">
                        <button class="custom-button">Explore project</button>
                    </div>
                </div>
            }

        </section>
    </section>
    }
    </body>
    </html>
