@model EditProjectViewModel
@using System.Security.Claims


<link rel="stylesheet" href="~/css/catalog.css" />
<script src="site.js" defer></script>
<script src="project.js" defer></script>

<section class="edit-project-popup" id="edit-project-popup">
    <div class="top-bar">
        <h2 id="edit-title">Create New Project</h2>
        <button class="icon-btn" id="close-edit-window">
            <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#000000"><path d="m251.33-204.67-46.66-46.66L433.33-480 204.67-708.67l46.66-46.66L480-526.67l228.67-228.66 46.66 46.66L526.67-480l228.66 228.67-46.66 46.66L480-433.33 251.33-204.67Z" /></svg>
        </button>
    </div>
    <div class="edit-project-form">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="Name" class="form-label">Project Name</label>
                <input type="text" class="form-control" id="Name" asp-for="Name" placeholder="@Model.Name">
            </div>
            <div class="mb-3">
                <label for="Description" class="form-label">Description</label>
                <textarea class="form-control" id="exampleFormControlTextarea1" rows="3" asp-for="Description"></textarea>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Project Image</label>
                <input class="form-control" type="file" id="image" accept="image/*" asp-for="ImageFile">
                <div id="fileHelp" class="form-text">Max 2MB, JPG/PNG/GIF</div>

            </div>
            <button type="submit" class="custom-button-accent">Submit</button>
        </form>
    </div>
</section>
